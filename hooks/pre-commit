#!/usr/bin/env sh
# Format check (ktlintCheck) + lint (detekt) before every commit.
# Enable: ./gradlew installGitHooks
# Bypass:      git commit --no-verify

set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"
if ! printf '%s\n' "$staged" | grep -qE '\.(kt|kts)$'; then
  exit 0
fi

echo "pre-commit: running ktlintCheck and detekt"

if ! ./gradlew ktlintCheck detekt --continue; then
  echo
  echo "pre-commit failed."
  echo "  Auto-format: ./gradlew ktlintFormat"
  echo "  See lint:    ./gradlew detekt"
  echo "  Bypass:      git commit --no-verify"
  exit 1
fi

#!/usr/bin/env sh

# Pre-commit: formatea, chequea ktlint/detekt, corre tests y build.
# Solo corre si hay archivos .kt/.kts en el stage. Proyecto multi-módulo.
# Enable: ./gradlew installGitHooks
# Bypass: git commit --no-verify

set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMR || true)"

# Si no hay .kt/.kts en el stage, no hacemos nada.
if ! printf '%s\n' "$staged" | grep -qE '\.(kt|kts)$'; then
  exit 0
fi

echo ""
echo "🔍  Running pre-commit checks..."
echo ""
echo "pre-commit: formateando y validando (ktlint, detekt, tests, build)"

#######################################
# 1) BUILD (compila todos los módulos)
#######################################
echo "🖥️   BUILD"
echo " (./gradlew assemble)  → Build completo..."
./gradlew assemble --quiet
echo "   ✅  Build OK"

#######################################
# 2) FORMAT (auto, sin frenar el commit)
#######################################
echo "🖥️   FORMAT"
echo " (./gradlew ktlintFormat)  → Formateando..."
./gradlew ktlintFormat --quiet

# Si el format tocó archivos que ya estaban en el stage, los re-agregamos
# para que el commit incluya la versión formateada.
changed_after_format="$(git diff --name-only --diff-filter=ACMR || true)"
to_restage="$(printf '%s\n' "$staged" | grep -E '\.(kt|kts)$' || true)"

if [ -n "$to_restage" ]; then
  for f in $to_restage; do
    if printf '%s\n' "$changed_after_format" | grep -qxF "$f"; then
      git add "$f"
    fi
  done
fi
echo "   ✅  Format aplicado"

#######################################
# 3) KTLINT CHECK
#######################################
echo "🖥️   LINT"
echo " (./gradlew ktlintCheck)  → Format check (ktlint)..."
./gradlew ktlintCheck --quiet
echo "   ✅  ktlint OK"

echo " (./gradlew detekt)  → Static analysis (detekt)..."
./gradlew detekt --quiet
echo "   ✅  detekt OK"

echo ""
echo "🎉  All checks passed!"
echo ""

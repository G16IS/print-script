{
  "order": [
    "keywords",
    "types",
    "operators",
    "literals",
    "identifiers"
  ],
  "config": {
    "keywords": [
      {
        "type": "exact",
        "matcher": ["let"],
        "token": "LET",
        "capture": false
      },
      {
        "type": "exact",
        "matcher": ["println"],
        "token": "CALL",
        "capture": true
      }
    ],
    "types": [
      {
        "type": "exact",
        "matcher": ["string", "number"],
        "token": "TYPE",
        "capture": true
      }
    ],
    "operators": [
      {
        "type": "exact",
        "matcher": [":"],
        "token": "COLON",
        "capture": false
      },
      {
        "type": "exact",
        "matcher": ["="],
        "token": "ASSIGN",
        "capture": false
      },
      {
        "type": "exact",
        "matcher": [";"],
        "token": "SEMICOLON",
        "capture": false
      },
      {
        "type": "exact",
        "matcher": ["("],
        "token": "LEFT_PAREN",
        "capture": false
      },
      {
        "type": "exact",
        "matcher": [")"],
        "token": "RIGHT_PAREN",
        "capture": false
      },
      {
        "type": "exact",
        "matcher": [","],
        "token": "COMMA",
        "capture": false
      }
    ],
    "literals": [
      {
        "type": "regex",
        "matcher": ["^\"[^\"]*\""],
        "token": "STRING_LITERAL",
        "capture": true,
        "partial": "^\""
      },
      {
        "type": "regex",
        "matcher": ["^[0-9]+(\\.[0-9]+)?"],
        "token": "NUMBER_LITERAL",
        "capture": true,
        "partial": "^[0-9]"
      }
    ],
    "identifiers": [
      {
        "type": "regex",
        "matcher": ["^[a-zA-Z_][a-zA-Z0-9_]*"],
        "token": "ID",
        "capture": true,
        "partial": "^[a-zA-Z_]"
      }
    ]
  }
}